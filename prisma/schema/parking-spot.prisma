model ParkingSpot {
  id           Int      @id @default(autoincrement())
  title        String
  neighborhood String
  address      String
  pricePerHour Int
  available    Boolean  @default(true)
  acceptsCars        Boolean @default(true)
  acceptsMotorcycles Boolean @default(true)
  covered            Boolean @default(false)
  hasSecurity        Boolean @default(false)
  hasCameras         Boolean @default(false)
  hasEvCharging      Boolean @default(false)
  // Ubicación para el mapa (vacía en los parqueaderos creados antes del mapa)
  latitude     Float?
  longitude    Float?
  rating       Float    @default(0)
  reviewCount  Int      @default(0)
  createdAt    DateTime @default(now())
  ownerId      Int
  owner        User    @relation(fields: [ownerId], references: [id])
  bookings     Booking[]
  photos       ParkingSpotPhoto[]
  favorites    Favorite[]
  conversations Conversation[]
  reviews       Review[]

  @@map("parking_spots")
} 