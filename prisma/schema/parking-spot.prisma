model ParkingSpot {
  id           Int      @id @default(autoincrement())
  title        String
  neighborhood String
  address      String
  pricePerHour Int
  available    Boolean  @default(true)
  rating       Float    @default(0)
  createdAt    DateTime @default(now())
  ownerId      Int
  owner        User    @relation(fields: [ownerId], references: [id])
  bookings     Booking[]
  photos       ParkingSpotPhoto[]
  favorites    Favorite[]

  @@map("parking_spots")
} 