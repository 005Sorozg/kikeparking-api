model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  parkingSpots ParkingSpot[]
  bookings     Booking[]
  favorites    Favorite[]
  conversations             Conversation[]
  conversationParticipants  ConversationParticipant[]
  messages                  Message[]
  supportRequests           SupportRequest[]
  driverRating              Float    @default(0)
  driverReviewCount         Int      @default(0)
  reviewsWritten            Review[] @relation("ReviewAuthor")
  reviewsReceived           Review[] @relation("ReviewedDriver")

  @@map("users")
}